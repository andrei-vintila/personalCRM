// Cloudflare Workers config. Nitro merges this into .output/server/wrangler.json
// at build time (`npm run build:cf`), so `wrangler deploy` works from the repo root.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prm",
  "account_id": "3b9847a3a0cfe3e0db63671e8ab61836",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prm",
      "database_id": "411ce9e8-bbfd-444b-bfba-55356d669cf6",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true }
  // Secrets: `npx wrangler secret put APP_PASSWORD`
}
