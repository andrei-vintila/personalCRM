# Required: the single password for signing in.
APP_PASSWORD=change-me
# Optional: cookie sealing secret (min 32 chars). Defaults to one derived from APP_PASSWORD.
# SESSION_SECRET=
# Node/VM only. Defaults to file:./data/prm.db. Turso/libsql URLs work too.
# DATABASE_URL=file:./data/prm.db
# DATABASE_AUTH_TOKEN=
# MIGRATIONS_DIR=./drizzle
# PORT=3000

# Google sync (Contacts, Calendar, Gmail metadata). See README → Google sync.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public URL, if the app sits behind a proxy and the OAuth redirect URI comes out wrong.
# APP_URL=https://prm.example.com
# How far back the first Gmail/Calendar sync goes (days).
# SYNC_BACKFILL_DAYS=180
